# Админка: из веба открываются только index.php и assets/, всё служебное закрыто.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<FilesMatch "\.(md|json|log|lock|sample\.php|local\.php)$|^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|bin|tests)(/|$) - [F,L]
</IfModule>
